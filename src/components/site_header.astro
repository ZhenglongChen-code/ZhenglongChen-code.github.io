---
type nav_item = {
  label: string;
  href: string;
  section: 'home' | 'work' | 'writing' | 'about';
};

const pathname = Astro.url.pathname;
const current_section = pathname === '/'
  ? 'home'
  : pathname === '/work' || pathname.startsWith('/work/')
    ? 'work'
    : pathname === '/about' || pathname.startsWith('/about/')
      ? 'about'
      : pathname === '/writing' || pathname.startsWith('/writing/')
          || pathname === '/en/writing' || pathname.startsWith('/en/writing/')
          || pathname === '/tags' || pathname.startsWith('/tags/')
        ? 'writing'
        : '';
const nav_items: nav_item[] = [
  { label: '首页', href: '/', section: 'home' },
  { label: '项目', href: '/work', section: 'work' },
  { label: '文章', href: '/writing', section: 'writing' },
  { label: '关于', href: '/about', section: 'about' },
];
const current_year = new Date().getFullYear();
---

<header class="site_header shell" lang="zh-CN">
  <a class="site_brand" href="/" aria-label="ChenZL，返回首页">ChenZL</a>
  <p class="masthead_note" aria-hidden="true"><span lang="en">Field Notes</span> · {current_year}</p>
  <nav class="primary_nav" aria-label="主要导航">
    <ul>
      {nav_items.map((nav_item) => (
        <li>
          <a
            href={nav_item.href}
            aria-current={current_section === nav_item.section ? 'page' : undefined}
          >
            {nav_item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
