---
import Site_footer from '../components/site_footer.astro';
import Site_header from '../components/site_header.astro';
import '../styles/global.css';

type article_metadata = {
  published_time: Date;
  modified_time?: Date;
};

type Props = {
  title: string;
  description: string;
  language: 'zh' | 'en';
  canonical_path?: string;
  noindex?: boolean;
  article?: article_metadata;
};

const {
  title,
  description,
  language,
  canonical_path,
  noindex = false,
  article,
} = Astro.props;
const canonical_url = canonical_path ? new URL(canonical_path, Astro.site) : undefined;
const html_language = language === 'zh' ? 'zh-CN' : 'en';
const og_locale = language === 'zh' ? 'zh_CN' : 'en_US';
---

<!doctype html>
<html lang={html_language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonical_url && <link rel="canonical" href={canonical_url} />}
    <title>{title}</title>

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical_url && <meta property="og:url" content={canonical_url} />}
    <meta property="og:locale" content={og_locale} />
    <meta property="og:site_name" content="Latent Field | Zhenglong Chen" />
    {article && (
      <meta property="article:published_time" content={article.published_time.toISOString()} />
    )}
    {article?.modified_time && (
      <meta property="article:modified_time" content={article.modified_time.toISOString()} />
    )}
  </head>
  <body class="paper_index">
    <a class="skip_link" href="#main_content" lang="zh-CN">跳到主要内容</a>
    <Site_header />
    <main id="main_content">
      <slot />
    </main>
    <Site_footer />
  </body>
</html>
