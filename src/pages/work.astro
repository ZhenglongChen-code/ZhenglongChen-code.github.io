---
import { getCollection as get_collection } from 'astro:content';
import Project_list from '../components/project_list.astro';
import Base_layout from '../layouts/base_layout.astro';

const work_entries = await get_collection('work');
const public_work = [...work_entries]
  .filter((work_entry) => !work_entry.data.draft)
  .sort((first_entry, second_entry) => (
    Number(second_entry.data.featured) - Number(first_entry.data.featured)
    || second_entry.data.year - first_entry.data.year
  ));
---

<Base_layout
  title="项目与研究 | ChenZL"
  description="ChenZL公开的多模态研究方向、AI 工具与项目实践。"
  language="zh"
  canonical_path="/work"
>
  <div class="shell">
    <header class="page_heading">
      <p class="section_kicker">Research / Projects / Tools</p>
      <h1>项目与研究</h1>
      <p>围绕多模态理解、模型推理与 AI 产品展开的公开研究方向和实践。</p>
    </header>
    <section class="archive_section" aria-label="全部公开项目">
      <Project_list work_entries={public_work} />
    </section>
  </div>
</Base_layout>
