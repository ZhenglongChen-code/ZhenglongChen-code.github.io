---
import { getCollection as get_collection } from 'astro:content';
import Post_list from '../components/post_list.astro';
import Project_list from '../components/project_list.astro';
import Base_layout from '../layouts/base_layout.astro';
import { get_public_posts, get_public_work } from '../lib/content';
import { calculate_reading_time } from '../lib/reading_time';
import { article_path } from '../lib/site_routes';

const all_writing = await get_collection('writing');
const public_writing = get_public_posts(all_writing);
const all_work = await get_collection('work');
const public_work = get_public_work(all_work);
const selected_work = public_work.filter((work_entry) => work_entry.data.featured);
const featured_post = public_writing.find((writing_entry) => writing_entry.data.featured);
const featured_reading_time = featured_post
  ? calculate_reading_time(featured_post.body ?? '', featured_post.data.language)
  : undefined;
const latest_writing = public_writing
  .filter((writing_entry) => writing_entry.id !== featured_post?.id)
  .slice(0, 3);
const featured_path = featured_post
  ? article_path(featured_post.id, featured_post.data.language)
  : '/articles';
const featured_language = featured_post?.data.language === 'en' ? 'en' : 'zh-CN';
const featured_label = featured_post?.data.language === 'en' ? 'Featured essay' : '精选文章';
const featured_link_label = featured_post?.data.language === 'en' ? 'Read the essay' : '阅读全文';
const featured_link_aria_label = featured_post
  ? featured_post.data.language === 'en'
    ? `Read the essay: ${featured_post.data.title}`
    : `阅读全文：${featured_post.data.title}`
  : undefined;
---

<Base_layout
  title="Zhenglong Chen | VLM Algorithm Engineer"
  description="Zhenglong Chen, VLM Algorithm Engineer. Research, writing, and project work."
  language="en"
  canonical_path="/"
>
  <div class="shell">
    <section class="hero" aria-labelledby="hero_title">
      <aside class="hero_margin" aria-label="Site index">
        <span>Portfolio / 2026</span>
        <span>Vision × Language × Intelligence</span>
      </aside>
      <div class="hero_heading">
        <p class="eyebrow">VLM Algorithm Engineer</p>
        <h1 id="hero_title">Zhenglong Chen</h1>
      </div>
      <div class="hero_copy">
        <p class="index_mark">[ Research note 01 ]</p>
        <p class="intro">VLM research, mathematical thinking, and AI products — with notes on the questions, systems, and long-form writing that connect them.</p>
        <p class="hero_detail">Multimodal learning<br />Visual reasoning<br />Model evaluation</p>
        <div class="hero_links">
          <a href="#selected_work">Selected index</a>
          <a href="#selected_writing">Latest notes</a>
        </div>
      </div>
    </section>

    <section class="home_section" id="selected_work" aria-labelledby="work_title">
      <header class="section_header">
        <div>
          <p class="section_kicker">01 / Index</p>
          <h2 id="work_title">Selected Research &amp; Projects</h2>
        </div>
        <nav class="section_links" aria-label="Selected work index">
          <a class="section_link" href="/research">Research</a>
          <a class="section_link" href="/projects">Projects</a>
        </nav>
      </header>
      <Project_list work_entries={selected_work} />
    </section>

    <section class="home_section writing_section" id="selected_writing" aria-labelledby="writing_title">
      <header class="section_header writing_header">
        <div>
          <p class="section_kicker">02 / Research notes</p>
          <h2 id="writing_title">Latest Articles</h2>
        </div>
        <a class="section_link" href="/articles">All articles</a>
      </header>

      <div class="editorial_grid">
        {featured_post && (
          <article class="featured_post" lang={featured_language}>
            <p class="featured_label">{featured_label}</p>
            <div class="featured_meta">
              <time datetime={featured_post.data.date.toISOString()}>
                {featured_post.data.date.toLocaleDateString(featured_language, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'Asia/Shanghai',
                })}
              </time>
              <span>{featured_post.data.language === 'zh' ? '中文' : 'English'}</span>
              {featured_reading_time && <span>{featured_reading_time.label}</span>}
            </div>
            <h3><a href={featured_path}>{featured_post.data.title}</a></h3>
            <p class="featured_summary">{featured_post.data.description}</p>
            <p class="featured_formula" aria-label="Multimodal inference notation">p(y | x, I) → y*</p>
            <a class="read_link" href={featured_path} aria-label={featured_link_aria_label}>
              {featured_link_label}
            </a>
          </article>
        )}

        <aside class="latest_posts" aria-label="Latest articles">
          <p class="list_heading">Recent index</p>
          <Post_list writing_entries={latest_writing} />
        </aside>
      </div>
    </section>
  </div>
</Base_layout>
