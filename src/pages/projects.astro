---
import { getCollection as get_collection } from 'astro:content';
import Project_list from '../components/project_list.astro';
import Base_layout from '../layouts/base_layout.astro';
import { get_public_work } from '../lib/content';

const work_entries = await get_collection('work');
const public_projects = get_public_work(work_entries)
  .filter((work_entry) => (
    work_entry.data.kind === 'project' || work_entry.data.kind === 'tool'
  ));
---

<Base_layout
  title="Projects | Zhenglong Chen"
  description="Zhenglong Chen's public projects."
  language="en"
  canonical_path="/projects"
>
  <div class="shell">
    <header class="page_heading">
      <p class="section_kicker">Projects / Tools</p>
      <h1>Projects</h1>
      <p>Public AI products, tools, and implementation work.</p>
    </header>
    <section class="archive_section" aria-label="Public projects and tools">
      <Project_list work_entries={public_projects} />
    </section>
  </div>
</Base_layout>
