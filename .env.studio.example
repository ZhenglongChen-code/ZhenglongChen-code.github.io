# Copy to .env.studio.local. Values stay on this machine and are never committed.
# Publishing remains disabled until every value below is configured.
STUDIO_REPOSITORY_ROOT=/absolute/path/to/latent-field-site
STUDIO_PUBLICATION_BRANCH=main
STUDIO_PUBLIC_SITE_URL=https://example.github.io
STUDIO_IMAGE_MAX_BYTES=20000000
# Total JSON payload limit, including base64 image data. Maximum: 30000000.
STUDIO_REQUEST_MAX_BYTES=25000000

TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_BUCKET=your-bucket-1234567890
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_PUBLIC_BASE_URL=https://assets.example.com
TENCENT_COS_ROOT_PREFIX=latent-field
