{
  "name": "zhenglong-personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3002",
    "build": "npm run test && npm run check && npm run export:social && astro build && node scripts/check_site.mjs",
    "check": "astro check",
    "preview": "astro preview --host 0.0.0.0 --port 3002",
    "test": "vitest run && npm run test:site-checker && npm run test:ops",
    "test:site-checker": "bash tests/site_checker.test.sh",
    "test:ops": "bash tests/deploy.test.sh && bash tests/bootstrap_server.test.sh",
    "test:watch": "vitest",
    "export:social": "tsx scripts/export_social.ts",
    "studio:build": "vite build --config studio/vite.config.ts",
    "studio:ui": "vite --config studio/vite.config.ts --host 127.0.0.1 --port 4317"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.3",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "entities": "^8.0.0",
    "gray-matter": "^4.0.3",
    "katex": "0.16.47",
    "marked": "^18.0.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
